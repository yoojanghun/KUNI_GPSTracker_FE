pipeline {
    agent any

    environment {
        S3_BUCKET_NAME = "gps-tracker-fe"
        AWS_REGION = "ap-northeast-2"
    }

    stages {
        stage('Checkout') {
            steps {
                // 젠킨스에 등록된 프론트엔드 Git 레포지토리 주소를 입력해주세요.
                git branch: 'infra', url: 'https://github.com/Kernel360/KUNI_GPSTracker_FE.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // 프론트엔드 소스코드가 있는 디렉토리에서 Docker 빌드를 실행합니다.
                    // Dockerfile.fe의 위치를 정확히 지정해야 합니다.
                    // 이 예제에서는 Jenkinsfile.fe와 Dockerfile.fe가 같은 infra 폴더에 있고,
                    // 실제 프론트엔드 소스는 체크아웃된 경로의 루트에 있다고 가정합니다.
                    // 만약 프론트엔드 소스가 하위 디렉토리에 있다면 docker build 명령어의 경로를 수정해야 합니다.
                    sh "docker build -t frontend-builder -f Dockerfile ."
                }
            }
        }

        stage('Extract dist from Docker Image') {
            steps {
                script {
                    // 빌드된 이미지에서 dist 폴더를 호스트(Jenkins Agent)로 복사합니다.
                    // 먼저 기존 dist 폴더가 있다면 삭제합니다.
                    sh "rm -rf ./dist"
                    sh "docker create --name temp-builder frontend-builder"
                    sh "docker cp temp-builder:/app/dist ./dist"
                    sh "docker rm temp-builder"
                }
            }
        }

        stage('Deploy to S3') {
            steps {
                script {
                    // 추출된 dist 폴더를 S3 버킷에 동기화합니다.
                    sh "aws s3 sync ./dist s3://${S3_BUCKET_NAME} --delete"
                    echo "Deployment to S3 bucket ${S3_BUCKET_NAME} completed."
                }
            }
        }
    }

    post {
        always {
            echo 'Frontend pipeline finished.'
        }
    }
}
